PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/erp_database
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173
NODE_ENV=development

# Initial Super Admin Seed (Used on first system start)
SUPER_ADMIN_NAME=Talkism Administrator
SUPER_ADMIN_EMAIL=superadmin@talkism.com
SUPER_ADMIN_PASSWORD=your_strong_superadmin_password_here

# SMTP Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM=Talkism Private Limited <your_email@gmail.com>

# Reverse Proxy Trust (Set to true if behind Nginx / Render / Cloudflare)
TRUST_PROXY=false
